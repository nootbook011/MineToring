{
  "name": "minetoring",
  "version": "0.7.5",
  "description": "Framework built on top Bedrock-Protocol, provides high-level API for creating bots on Minecraft Bedrock.",
  "main": "./src/lib/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 0"
  },
  "keywords": [
    "minecraft",
    "bedrock",
    "pocket-edition",
    "bedrock-edition",
    "protocol",
    "bots"
  ],
  "type": "module",
  "imports": {
    "#Base/*": "./src/Core/*.js",
    "#Main/*": "./src/lib/*.js",
    "#Client/*": "./src/Core/BedrockClient/*.js",
    "#Server/*": "./src/Core/BedrockServer/*.js",
    "#World/*": "./src/Core/BedrockWorld/*.js",
    "#Storage/*": "./src/Core/BedrockStorage/*.js",
    "#extra/*": "./src/extra/*.js"
  },
  "exports": {
    ".": "./src/lib/index.js",
    "./BasePlugin": "./src/Core/BedrockStorage/moduleBase.js",
    "./*": "./src/*.js"
  },
  "author": "nootbook011",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nootbook011/MineToring.git"
  },
  "bugs": {
    "url": "https://github.com/nootbook011/MineToring/issues"
  },
  "homepage": "https://github.com/nootbook011/MineToring#readme",
  "dependencies": {
    "bedrock-protocol": "^3.51.0",
    "minecraft-data": "^3.110.2",
    "pngjs": "^7.0.0",
    "prismarine-block": "^1.23.0",
    "prismarine-nbt": "^2.8.0",
    "random": "^5.4.1",
    "uuid": "^13.0.0"
  }
}
